# --- Database ---
# Matches docker-compose.yml's postgres service (host port 5434 -> container 5432)
DATABASE_URL="postgresql://rag_chatbot:rag_chatbot@localhost:5434/rag_chatbot"

# --- Redis (LangGraph checkpointer hot-path store) ---
# Matches docker-compose.yml's redis service (host port 6380 -> container 6379)
REDIS_URL="redis://localhost:6380"

# --- LLM / embeddings (OpenAI, behind the provider-agnostic interface in packages/api/src/services) ---
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Optional — model for the query-rewrite call only (retrieval/query-rewrite.ts).
# Leave unset to use OPENAI_CHAT_MODEL for rewrite too (no behavior change).
OPENAI_REWRITE_MODEL=
# Optional — Azure-OpenAI-compatible gateway or self-hosted endpoint. Leave
# unset to use OpenAI's own API.
OPENAI_BASE_URL=

# --- API server ---
# 4001, not 4000 — already taken by other projects on shared dev machines.
PORT=4001
NODE_ENV="development"

# --- Admin panel auth ---
ADMIN_SESSION_SECRET=""
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# --- Rate limiting (per session/IP on /chat) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
