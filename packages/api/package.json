{
  "name": "@rag-chatbot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js",
    "ingest": "tsx src/kb/cli-ingest.ts",
    "eval": "tsx src/eval/cli-run.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint-redis": "^1.0.11",
    "@prisma/client": "^5.22.0",
    "@rag-chatbot/shared": "*",
    "cors": "^2.8.5",
    "docling.rs": "^1.69.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^7.23.0",
    "redis": "^4.7.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
